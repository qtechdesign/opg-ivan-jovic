/**
 * Placeholder Wrangler config for a Polje fork.
 * Copy values into wrangler.jsonc — do not commit this instance’s D1 id, R2, or .hr routes.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polje",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SERVICE_NAME": "polje",
    "DEFAULT_FARM_SLUG": "YOUR-FARM-SLUG"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polje",
      "database_id": "YOUR-D1-DATABASE-ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "YOUR-R2-BUCKET"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST", "queue": "polje-ingest" }
    ],
    "consumers": [
      {
        "queue": "polje-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "FARM", "class_name": "FarmRuntime" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-farm-runtime",
      "new_sqlite_classes": ["FarmRuntime"]
    }
  ]
}
