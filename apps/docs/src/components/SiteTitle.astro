---
const href = "https://opg-ivanjovic.hr";
---

<a href={href} class="site-title sl-flex" title="OPG Ivan Jović">
	<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
		<rect x="11" y="6.2" width="10" height="2.6"></rect>
		<rect x="8.4" y="12" width="15.2" height="2.6"></rect>
		<rect x="5.8" y="17.8" width="20.4" height="2.6"></rect>
		<rect x="3.2" y="23.6" width="25.6" height="2.6"></rect>
	</svg>
	<span class="brand-text" translate="no">Polje · OPG Ivan Jović</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: 10px;
		min-width: 0;
		color: inherit;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-size: 12px;
		font-family: "D-DIN", "IBM Plex Sans", system-ui, sans-serif;
	}
	.brand-mark {
		width: 22px;
		height: 22px;
		flex-shrink: 0;
		display: block;
	}
	.brand-text {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.site-title:hover {
		color: var(--spectral);
	}
</style>
