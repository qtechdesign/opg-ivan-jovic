/**
 * Polje public docs — static Starlight on Workers Assets.
 * Separate from the farm Worker (polje). No D1 / R2 / secrets.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "polje-docs",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "docs.opg-ivanjovic.hr", "custom_domain": true }
  ]
}
