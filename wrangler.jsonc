/**
 * Polje Worker — M0–M10 + mail + ledger + FPS + KV
 *
 * Public: opg-ivanjovic.hr + www.opg-ivanjovic.hr
 * Cron: every 5 min (irrigation schedules + yesterday solar settle + analog climate + 06:00 Zagreb briefing gate)
 * KV: flags, farm-row cache, rate limits (session stays HttpOnly cookie)
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polje",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SERVICE_NAME": "polje",
    "DEFAULT_FARM_SLUG": "ivan-jovic",
    "OPERATOR_EMAIL": "info@qtech.hr"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "603d5e24f1b6480793ec0c53886a4a30",
      "preview_id": "027aca6a1fff43d29e0bb18a9550dfc7"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "polje"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polje",
      "database_id": "5413c190-29d4-406d-aa61-2dd44a489aca",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "polje-media"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST", "queue": "polje-ingest" }
    ],
    "consumers": [
      {
        "queue": "polje-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FARM", "class_name": "FarmRuntime" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-farm-runtime",
      "new_sqlite_classes": ["FarmRuntime"]
    }
  ],
  "routes": [
    { "pattern": "opg-ivanjovic.hr", "custom_domain": true },
    { "pattern": "www.opg-ivanjovic.hr", "custom_domain": true }
  ]
}
