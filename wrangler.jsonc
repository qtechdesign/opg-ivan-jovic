/**
 * Polje Worker — M0–M2
 *
 * Public: opg-ivanjovic.hr + www.opg-ivanjovic.hr
 * Bindings: D1 + R2 + Queue + FarmRuntime DO
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polje",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SERVICE_NAME": "polje"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polje",
      "database_id": "5413c190-29d4-406d-aa61-2dd44a489aca",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "polje-media"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST", "queue": "polje-ingest" }
    ],
    "consumers": [
      {
        "queue": "polje-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "FARM", "class_name": "FarmRuntime" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-farm-runtime",
      "new_sqlite_classes": ["FarmRuntime"]
    }
  ],
  "routes": [
    { "pattern": "opg-ivanjovic.hr", "custom_domain": true },
    { "pattern": "www.opg-ivanjovic.hr", "custom_domain": true }
  ]
}
