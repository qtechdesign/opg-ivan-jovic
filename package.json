{
  "name": "polje",
  "version": "0.0.1",
  "private": true,
  "description": "Polje — farm OS for OPG Ivan Jović (and forks)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply polje --local",
    "db:migrate:remote": "wrangler d1 migrations apply polje --remote",
    "seed:local": "node scripts/seed.mjs",
    "seed:remote": "node scripts/seed.mjs --remote",
    "docs:dev": "npm run dev -w polje-docs",
    "docs:build": "npm run build -w polje-docs",
    "docs:deploy": "npm run deploy -w polje-docs",
    "og:imagine": "node scripts/og-imagine.mjs",
    "hero:imagine": "node scripts/hero-imagine.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20250906.0",
    "@vitest/snapshot": "^3.0.9",
    "typescript": "^5.9.2",
    "vitest": "~3.0.9",
    "wrangler": "4.35.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "hono": "^4.9.0",
    "postal-mime": "^2.4.4",
    "zod": "^4.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
